TZ=Asia/Tokyo

# https://github.com/settings/emails の @users.noreply.github.com のメールアドレスを登録してください。
GIT_AUTHOR_NAME=Name
GIT_AUTHOR_EMAIL=xxx+xxx@users.noreply.github.com
GIT_COMMITTER_NAME=Name
GIT_COMMITTER_EMAIL=xxx+xxx@users.noreply.github.com

# プロジェクト固有の名前に置き換えてください。この名前単位で volumes が管理されます。
DEVCONTAINER_ID=sgw-sample

# sekimore-relay (docker-compose.relay.yml): 依頼者の ssh-agent socket (sekimore-gw が上流 git の認証に使う)。
#   Docker Desktop (Mac): 既定の /run/host-services/ssh-auth.sock でよい (Docker Desktop がホストの agent を転送する)
#   Vagrant VM:           固定パスに socket を用意する。例 (Mac から):
#                         ssh -N -o StreamLocalBindUnlink=yes -R /home/vagrant/.ssh-agent/agent.sock:$SSH_AUTH_SOCK <vm>
#                         → SEKIMORE_AGENT_SOCK=/home/vagrant/.ssh-agent/agent.sock
SEKIMORE_AGENT_SOCK=/run/host-services/ssh-auth.sock
# 使い捨て鍵の登録と案件トークンの発行を自動化するか: auto | manual
SEKIMORE_BOOTSTRAP=auto
